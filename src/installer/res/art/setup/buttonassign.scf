##NightFalcon
##FF7 - device button assignment window (#18). For the function already selected
## (in the MAIN button settings window): device + button + modifier + autodetect.
## Function list and search live in the MAIN window, NOT here.
## Text is set in code (controltab.cpp), coordinates relative to the window.

[WINDOW]
[SETUP] SETUP_BTNASSIGN_WIN, C_TYPE_NORMAL, 470, 250
[XY] 277, 260
[RANGES] 0, 0, 1024, 768, 470, 250
[GROUP] 7000
[FONT] OCR_EXT_12
[CLIENTAREA] 0, 0, 470, 250, 0 "entire window"

## opaque background: same WIN_SETUP shifted by -XY of the window (seamless with the
## setup screen background; ui95 has no filled-rectangle primitive)
[BITMAP]
[SETUP] NID 0 WIN_SETUP
[XY] -277 -260
[FLAGBITON] C_BIT_ABSOLUTE

## panel frame
[BOX]
[SETUP] NID 0
[XYWH] 2 2 465 245
[COLOR] 180 200 220
[FLAGBITON] C_BIT_ABSOLUTE

[BOX]
[SETUP] NID 0
[XYWH] 6 6 457 237
[COLOR] 80 110 140
[FLAGBITON] C_BIT_ABSOLUTE

## title (code: "Assign: <function>")
[TEXT]
[SETUP] BTNASSIGN_TITLE C_TYPE_LEFT
[XY] 16 12
[FONT] BANK_GOTHIC_16
[FGCOLOR] 230 230 230
[FLAGBITON] C_BIT_ABSOLUTE

## device
[TEXT]
[SETUP] BTNASSIGN_LBL_DEVICE C_TYPE_LEFT
[XY] 16 46
[FONT] OCR_EXT_12
[FGCOLOR] 200 220 240
[FLAGBITON] C_BIT_ABSOLUTE

## #53 device is chosen by clicking the cell (no dropdown) - show it as green text
[TEXT]
[SETUP] BTNASSIGN_DEVICE_LABEL C_TYPE_LEFT
[XY] 130 46
[FONT] OCR_EXT_12
[FGCOLOR] 0 255 0
[FLAGBITON] C_BIT_ABSOLUTE

## button (manual select) + modifier (keyboard)
[TEXT]
[SETUP] BTNASSIGN_LBL_BUTTON C_TYPE_LEFT
[XY] 16 88
[FONT] OCR_EXT_12
[FGCOLOR] 200 220 240
[FLAGBITON] C_BIT_ABSOLUTE

[LISTBOX]
[SETUP] BTNASSIGN_BUTTON_LIST 0
[XYWH] 130 86 150 15
[NORMCOLOR] 230 230 230
[SELCOLOR] 0 255 0
[FONT] OCR_EXT_12
[DROPDOWN] BID_DROPDOWN
[FLAGBITON] C_BIT_ABSOLUTE
[CURSOR] CRSR_LIST_F16
[SOUNDBITE] SND_MENU C_TYPE_LMOUSEDOWN

[TEXT]
[SETUP] BTNASSIGN_LBL_MOD C_TYPE_LEFT
[XY] 296 88
[FONT] OCR_EXT_12
[FGCOLOR] 200 220 240
[FLAGBITON] C_BIT_ABSOLUTE

[LISTBOX]
[SETUP] BTNASSIGN_MODIFIER_LIST 0
[XYWH] 360 86 92 15
[NORMCOLOR] 230 230 230
[SELCOLOR] 0 255 0
[FONT] OCR_EXT_12
[DROPDOWN] BID_DROPDOWN
[FLAGBITON] C_BIT_ABSOLUTE
[CURSOR] CRSR_LIST_F16
[SOUNDBITE] SND_MENU C_TYPE_LMOUSEDOWN

## autodetect hint + "detected" field
[TEXT]
[SETUP] BTNASSIGN_AUTODETECT C_TYPE_LEFT
[XY] 16 122
[FONT] OCR_EXT_12
[FGCOLOR] 0 230 120
[FLAGBITON] C_BIT_ABSOLUTE

## Redetect button (LEFT of the detected field; restarts capture). Layout later.
[BUTTON]
[SETUP] BTNASSIGN_DETECT, C_TYPE_NORMAL, 16 140
[IMAGES] BID_CHK1_OFF BID_CHK1_ON NULL NULL
[GROUP] 7000
[SOUNDBITE] SND_MENU C_TYPE_LMOUSEUP
[CURSOR] CRSR_F16_ON

[TEXT]
[SETUP] BTNASSIGN_DETECTED C_TYPE_LEFT
[XY] 120 144
[FONT] OCR_EXT_12
[FGCOLOR] 0 230 120
[FLAGBITON] C_BIT_ABSOLUTE

## OK / Cancel (text set in code via C_Button::SetText). BID_CLOSE not in setup,
## use BID_CHK1 as a clickable button.
[BUTTON]
[SETUP] BTNASSIGN_ASSIGN, C_TYPE_NORMAL, 150 210
[IMAGES] BID_CHK1_OFF BID_CHK1_ON NULL NULL
[GROUP] 7000
[SOUNDBITE] SND_MENU C_TYPE_LMOUSEUP
[CURSOR] CRSR_F16_ON

[BUTTON]
[SETUP] BTNASSIGN_OPEN, C_TYPE_NORMAL, 290 210
[IMAGES] BID_CHK1_OFF BID_CHK1_ON NULL NULL
[GROUP] 7000
[SOUNDBITE] SND_MENU C_TYPE_LMOUSEUP
[CURSOR] CRSR_F16_ON
