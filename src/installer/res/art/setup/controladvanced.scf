[SETUP] NID 0 BAR_M
[XYWH] 0 728 1024 40
[FLAGBITON] C_BIT_ABSOLUTE
[FLAGBITON] C_BIT_HORIZONTAL

[TILE]
[SETUP] NID 0 BAR_O
[XYWH] 0 0 1024 32
[FLAGBITON] C_BIT_ABSOLUTE
[FLAGBITON] C_BIT_HORIZONTAL

