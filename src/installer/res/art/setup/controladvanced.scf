#FF4

[WINDOW]
[SETUP] SETUP_CONTROL_ADVANCED_WIN C_TYPE_EXCLUSIVE 1024 768
[XY] 0 0
[RANGES] 0 0 1024 768 1024 768
## client 0 = whole window, client 1 = AXIS SETUP scroll zone.
## client 2 (CONTROLS SETUP table area) is set from code in AdvancedControlCB via
## win->SetClientArea(167,160,678,506,2) - declaring a 3rd client area here breaks the
## window parse (controls after it are not created).
[CLIENTAREA] 0 0 1024 768 0 "entire window"
## #53 axis scroll zone clipped to the grey panel (top 125 .. bottom 688). VY_=0 so rows
## (client-y 130+) appear at the panel top; height 688 clips overflow at the panel bottom.
[CLIENTAREA] 0 25 1024 663 1 "axis scroll"
[FONT] OCR_EXT_14
[GROUP] 500

[BITMAP]
[SETUP] NID C_STATE_DOWN WIN_SETUP

[BITMAP]
[SETUP] NID 0 SETUP_HEADER_JOY
[XY] 262 525 500 85
[FLAGBITON] C_BIT_ABSOLUTE

## #53 vertical scrollbar for AXIS SETUP (controls client 1; visible only on cluster 10002)
[SCROLLBAR]
[SETUP] NID C_TYPE_VERTICAL
[XYWH] 845 125 13 563
[CLIENT] 1
[FLAGBITON] C_BIT_ABSOLUTE
[SLIDERIMAGE] BID_SCROLL
[BUTTONIMAGES] BID_SCROLLCAP_TOP_OFF BID_SCROLLCAP_TOP_ON BID_SCROLLCAP_BOTTOM_OFF BID_SCROLLCAP_BOTTOM_ON
[BGLINE] 65 128 173
[CLUSTER] 10002
[CURSOR] CRSR_F16_ON
[DRAGCURSOR] CRSR_VDRAG_ON
[INCREMENT] 16

############################## #53 CONTROLS SETUP table (cluster 10005) #########################
## Table lives in client 2 ("controls table"): rows cloned in code from templates
## KEYCODES/MAPPING/HLINE/VLINE. Columns: function(desc) | keyboard | per-device cells.
## Per-device columns + header row are built in code (UpdateKeyMapList/BuildTableHeader).
## client 2 is scrollable both ways: vertical + horizontal scrollbars below.
## #53 (client 2 "controls table" is set from code via SetClientArea in AdvancedControlCB)

## #53 background for THIS tab only (cluster 10005): light frame + grey table panel.
## Packed into win_all under id WIN_CTLTBL (src/tools/rsc_pack.py). Window-wide WIN_SETUP
## still shows on the other tabs. Drawn before the table controls so it stays behind them.
[BITMAP]
[SETUP] NID 0 WIN_CTLTBL
[XY] 0 0
[FLAGBITON] C_BIT_ABSOLUTE
[CLUSTER] 10005

## #53 same background on AXIS SETUP tab (cluster 10002)
[BITMAP]
[SETUP] NID 0 WIN_CTLTBL
[XY] 0 0
[FLAGBITON] C_BIT_ABSOLUTE
[CLUSTER] 10002

## #53 same background on AVIONICS tab (cluster 10003)
[BITMAP]
[SETUP] NID 0 WIN_CTLTBL
[XY] 0 0
[FLAGBITON] C_BIT_ABSOLUTE
[CLUSTER] 10003

## #53 top/bottom metal bars drawn AFTER WIN_CTLTBL so they stay visible on the table/axis/
## avionics tabs (WIN_CTLTBL is a full-window 1024x768 image that would otherwise cover them).
