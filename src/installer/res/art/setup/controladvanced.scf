[STATE] 0
[GROUP] 100
[FLAGBITON] C_BIT_ABSOLUTE
[SOUNDBITE] SND_RADIO C_TYPE_MOUSEOVER
[SOUNDBITE] SND_FILE C_STATE_DOWN
[USERDATA] C_STATE_0 10001 "Enable"
[USERDATA] C_STATE_1 10005 "Disable the rest"
[USERDATA] C_STATE_2 10002
[USERDATA] C_STATE_3 10003
